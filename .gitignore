# --- Separate application repositories (tracked in their own git repos) ---
/backend/
/frontend/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Claude Code local files ---
.claude/

# --- Spec Kit machine-local state ---
.specify/feature.json
.specify/extensions/*/local-config.yml

# --- OS junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# --- Python (if tooling runs from repo root) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (if tooling runs from repo root) ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Logs / temp ---
*.log
tmp/
.cache/
